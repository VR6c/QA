# Node Server Environment
NODE_ENV=development
PORT=5001

# Local Development Database
MONGODB_URI=mongodb://localhost:27017/qa_app

# Production Database (For Vercel / Cloud Deployment)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/qa_app

# JWT Authentication Secret Key (Generate with: openssl rand -hex 64)
JWT_SECRET=your_jwt_secret_key_here

# Initial Production Super Admin Account Configuration
ADMIN_NAME=System Super Admin
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password_here
